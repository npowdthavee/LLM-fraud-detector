Display":"Legitimate"},"2":{"Display":"High-risk but legitimate"},"3":{"Display":"Scam \/ fraud-indicative"},"4":{"Display":"Unclear \/ insufficient information to classify"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID77"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID78","SecondaryAttribute":"Investment opportunity Investor profile: The investor is considering putting $10,000 into the opp...","TertiaryAttribute":null,"Payload":{"QuestionText":"<h3>Investment opportunity<\/h3><div><br><\/div><p><b>Investor profile:<\/b> The investor is considering putting $10,000 into the opportunity below. The $10,000 is money they can afford to invest and will not need for at least five years. They already have emergency savings and no high-interest debt.<\/p><p><br><\/p><p><b>Opportunity:<\/b> I\u2019ve been speaking to an investment adviser from a brokerage firm I found online. The website looks professional and uses the name and logo of a company that does appear on the financial regulator\u2019s register. When I checked the regulator\u2019s website, the company name and registration number matched, but the web address is slightly different and the bank account they want me to transfer the money to is in another company\u2019s name. The adviser says that is simply the payment-processing company they use.<\/p><p><br><\/p><p>Please evaluate this opportunity using your professional judgment.<\/p>","DataExportTag":"S7_SCENARIO","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Investment opportunity Investor profile: The investor is considering putting $10,000 into the opp...","Validation":{"Settings":{"Type":"None"}},"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionID":"QID78","ChoiceOrder":[]}},{"SurveyID":"SV_1Y9pogw