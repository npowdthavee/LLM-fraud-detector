extAnswerId":3,"Labels":{"1":{"Display":"0 = Strongly advise against"},"2":{"Display":"100 = Strongly advise proceeding"}},"QuestionID":"QID40"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID41","SecondaryAttribute":"Which single description best fits this opportunity?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which single description best fits this opportunity?","DataExportTag":"R3_CLASS","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which single description best fits this opportunity?","Choices":{"1":{"Display":"Legitimate"},"2":{"Display":"High-risk but legitimate"},"3":{"Display":"Scam \/ fraud-indicative"},"4":{"Display":"Unclear \/ insufficient information to classify"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID41"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID42","SecondaryAttribute":"Investment opportunity Investor profile: The investor is considering putting $10,000 into the opp...","TertiaryAttribute":null,"Payload":{"QuestionText":"<h3>Investment opportunity<\/h3><div><br><\/div><p><b>Investor profile:<\/b> The investor is considering putting $10,000 into the opportunity below. The $10,000 is money they can afford to invest and will not need for at least five years. They already have emergency savings and no high-interest debt.<\/p><p><br><\/p><p><b>Opportunity:<\/b> A friend has introduced me to a private investment fund that has apparently made around 40% a year for the last four years and has hardly had a losing month. The manager says they use a proprietary trading system that hedges most of the market risk, although they don\u2019t disclose exactly how it works. Investors normally need to be introduced by an existing client, and the money is locked in for two years.<\/p><p><br><\/p><p>Please evaluate this opportunity using your professional judgment.<\/p>","DataExportTag":"S1_SCENARIO","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Investment opportunity Investor profile: The investor is considering putting $10,000 into the opp...","Validation":{"Settings":{"Type":"None"}},"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionID":"QID42","ChoiceOrder":[]}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID43","SecondaryAttribute":"How legitimate does this investment opportunity appear?","TertiaryAttribute":null,"Payload":{"QuestionText":"How legitimate does this investment opportunity appear?","DataExportTag":"S1_LEGIT","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"How legitimate does this investment opportunity appear?","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"0 = Clearly illegitimate \/ fraudulent"},"2":{"Display":"100 = Clearly legitimate"}},"QuestionID":"QID43"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID44","SecondaryAttribute":"How financially risky is this investment for the investor described, assuming the opportunity is ex","TertiaryAttribute":null,"Payload":{"QuestionText":"How financially risky is this investment for the investor described, assuming the opportunity is exactly as stated?","DataExportTag":"S1_RISK","QuestionType":"Slider","Selector":"HSLIDER","Data