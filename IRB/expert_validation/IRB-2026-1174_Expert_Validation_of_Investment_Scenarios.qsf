ly high financial risk"}},"QuestionID":"QID32"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID33","SecondaryAttribute":"How strongly does this description contain red flags associated with scams or fraud?","TertiaryAttribute":null,"Payload":{"QuestionText":"How strongly does this description contain red flags associated with scams or fraud?","DataExportTag":"R2_FRAUD","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"How strongly does this description contain red flags associated with scams or fraud?","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"0 = No scam \/ fraud red flags"},"2":{"Display":"100 = Very strong scam \/ fraud red flags"}},"QuestionID":"QID33"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID34","SecondaryAttribute":"How advisable would it be for this investor to make the $10,000 investment?","TertiaryAttribute":null,"Payload":{"QuestionText":"How advisable would it be for this investor to make the $10,000 investment?","DataExportTag":"R2_ADVISE","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"How advisable would it be for this investor to make the $10,000 investment?","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","