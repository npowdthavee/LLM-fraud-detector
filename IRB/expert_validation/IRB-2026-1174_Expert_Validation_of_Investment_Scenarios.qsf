":null,"Payload":{"QuestionText":"How advisable would it be for this investor to make the $10,000 investment?","DataExportTag":"S1_ADVISE","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"How advisable would it be for this investor to make the $10,000 investment?","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"0 = Strongly advise against"},"2":{"Display":"100 = Strongly advise proceeding"}},"QuestionID":"QID46"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID47","SecondaryAttribute":"Which single description best fits this opportunity?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which single description best fits this opportunity?","DataExportTag":"S1_CLASS","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which single description best fits this opportunity?","Choices":{"1":{"Display":"Legitimate"},"2":{"Display":"High-risk but legitimate"},"3":{"Display":"Scam \/ fraud-indicative"},"4":{"Display":"Unclear \/ insufficient information to classify"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID47"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID48","SecondaryAttribute":"Investment opportunity Investor profile: The investor is considering putting $10,000 into the opp...","TertiaryAttribute":null,"Payload":{"QuestionText":"<h3>Investment opportunity<\/h3><div><br><\/div><p><b>Investor profile:<\/b> The investor is considering putting $10,000 into the opportunity below. The $10,000 is money they can afford to invest and will not need for at least five years. They already have emergency savings and no high-interest debt.<\/p><p><br><\/p><p><b>Opportunity:<\/b> Someone I know has suggested a private fund that has apparently returned around 10\u201312% a year for almost a decade. What caught my attention is that it hasn\u2019t had a losing year, even during periods when financial markets were doing badly. The manager says they use a proprietary fixed-income arbitrage strategy and don\u2019t disclose much detail about it. The fund is audited by a small accounting firm, most investors seem to come through introductions, and withdrawals need several months\u2019 notice.<\/p><p><br><\/p><p>Please evaluate this opportunity using your professional judgment.<\/p>","DataExportTag":"S2_SCENARIO","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Investment opportunity Investor profile: The investor is considering putting $10,000 into the opp...","Validation":{"Settings":{"Type":"None"}},"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionID":"QID48","ChoiceOrder":[]}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID49","SecondaryAttribute":"How legitimate does this investment opportunity appear?","TertiaryAttribute":null,"Payload":{"QuestionText":"How legitimate does this investment opportunity appear?","DataExportTag":"S2_LEGIT","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescri