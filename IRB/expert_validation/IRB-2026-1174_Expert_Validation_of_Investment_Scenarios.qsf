n contain red flags associated with scams or fraud?","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"0 = No scam \/ fraud red flags"},"2":{"Display":"100 = Very strong scam \/ fraud red flags"}},"QuestionID":"QID81"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID82","SecondaryAttribute":"How advisable would it be for this investor to make the $10,000 investment?","TertiaryAttribute":null,"Payload":{"QuestionText":"How advisable would it be for this investor to make the $10,000 investment?","DataExportTag":"S7_ADVISE","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"How advisable would it be for this investor to make the $10,000 investment?","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"0 = Strongly advise against"},"2":{"Display":"100 = Strongly advise proceeding"}},"QuestionID":"QID82"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID83","SecondaryAttribute":"Which single description best fits this opportunity?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which single description best fits this opportunity?","DataExportTag":"S7_CLASS","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which single description best fits this opportunity?","Choices":{"1":{"Display":"Legitimate"},"2":{"Display":"High-risk but legitimate"},"3":{"Display":"Scam \/ fraud-indicative"},"4":{"Display":"Unclear \/ insufficient information to classify"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID83"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID84","SecondaryAttribute":"Investment opportunity Investor profile: The investor is considering putting $10,000 into the opp...","TertiaryAttribute":null,"Payload":{"QuestionText":"<h3>Investment opportunity<\/h3><div><br><\/div><p><b>Investor profile:<\/b> The investor is considering putting $10,000 into the opportunity below. The $10,000 is money they can afford to invest and will not need for at least five years. They already have emergency savings and no high-interest debt.<\/p><p><br><\/p><p><b>Opportunity:<\/b> I\u2019ve been offered the chance to buy a small plot of undeveloped land. The company says the area is likely to be approved for housing in the future and that, if planning permission is granted, the land could rise in value by 25\u201340%. They showed me examples of other plots that they say increased substantially in value after planning permission was granted. There isn\u2019t planning permission for this particular site yet, and if I wanted to sell before then I would probably have to rely on the company finding another buyer.<\/p><p><br><\/p><p>Please evaluate this opportunity using your professional judgment.<\/p>","DataExportTag":"S8_SCENARIO","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Investment opportunity Investor profile: The investor is considering putting $10,000 into the opp...","Validation":{"Settings":{"Type":"None"}},"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionID":"QID84","ChoiceOrder":[]}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID85","SecondaryAttribute":"How legitimate does this investment opportunity appear?","TertiaryAttribute":null,"Payload":{"QuestionText":"How legitimate does this investment opportunity appear?","DataExportTag":"S8_LEGIT","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"How legitimate does this investment opportunity appear?","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"0 = Clearly illegitimate \/ fraudulent"},"2":{"Display":"100 = Clearly legitimate"}},"QuestionID":"QID85"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID86","SecondaryAttribute":"How financially risky is this investment for the investor described, assuming the opportunity is ex","TertiaryAttribute":null,"Payload":{"QuestionText":"How financially risky is this investment for the investor described, assuming the opportunity is exactly as stated?","DataExportTag":"S8_RISK","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"How financially risky is this investment for the investor described, assuming the opportunity is ex","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"0 = Very low financial risk"},"2":{"Display":"100 = Extremely high financial risk"}},"QuestionID":"QID86"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID87","SecondaryAttribute":"How strongly does this description contain red flags associated with scams or fraud?","TertiaryAttribute":null,"Payload":{"QuestionText":"How strongly does this description contain red flags associated with scams or fraud?","DataExportTag":"S8_FRAUD","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"How strongly does this description contain red flags associated with scams or fraud?","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"0 = No scam \/ fraud red flags"},"2":{"Display":"100 = Very strong scam \/ fraud red flags"}},"QuestionID":"QID87"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID88","SecondaryAttribute":"How advisable would it be for this investor to make the $10,000 investment?","TertiaryAttribute":null,"Payload":{"QuestionText":"How advisable would it be for this investor to make the $10,000 investment?","DataExportTag":"S8_ADVISE","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"How advisable would it be for this investor to make the $10,000 investment?","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"0 = Strongly advise against"},"2":{"Display":"100 = Strongly advise proceeding"}},"QuestionID":"QID88"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID89","SecondaryAttribute":"Which single description best fits this opportunity?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which single description best fits this opportunity?","DataExportTag":"S8_CLASS","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which single description best fits this opportunity?","Choices":{"1":{"Display":"Legitimate"},"2":{"Display":"High-risk but legitimate"},"3":{"Display":"Scam \/ fraud-indicative"},"4":{"Display":"Unclear \/ insufficient information to classify"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID89"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID9","SecondaryAttribute":"How strongly does this description contain red flags associated with scams or fraud?","TertiaryAttribute":null,"Payload":{"QuestionText":"How strongly does this description contain red flags associated with scams or fraud?","DataExportTag":"L1_FRAUD","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"How strongly does this description contain red flags associated with scams or fraud?","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"0 = No scam \/ fraud red flags"},"2":{"Display":"100 = Very strong scam \/ fraud red flags"}},"QuestionID":"QID9"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID90","SecondaryAttribute":"Study Information Sheet","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2 style=\"text-align:center;\">Study Information Sheet<\/h2>\n<p><b>IRB reference number:<\/b> IRB-2026-1174<br>\n<b>Title of Study:<\/b> Expert Validation of Investment Scenarios for AI Financial-Advice Research<br>\n<b>Principal Investigator:<\/b> Nattavudh (Nick) Powdthavee, Nanyang Technological University (NTU)<br>\n<b>Email:<\/b> nick.powdthavee@ntu.edu.sg<\/p>\n\n<h3>Introduction<\/h3>\n<p>You are invited to participate in a research study investigating how finance-experienced adults evaluate hypothetical investment opportunities. Please read this information carefully before deciding whether to take part.<\/p>\n\n<h3>Procedures<\/h3>\n<p>If you agree to participate, you will complete an online task involving hypothetical investment scenarios.<\/p>\n<ol>\n<li><b>Evaluate investment scenarios:<\/b> You will evaluate 14 fictional investment opportunities involving the same hypothetical investor considering investing US$10,000.<\/li>\n<li><b>Provide ratings:<\/b> For each opportunity, you will rate legitimacy, financial risk, scam\/fraud red flags, and advisability, then choose the category that best describes the opportunity.<\/li>\n<li><b>Complete a brief questionnaire:<\/b> You will answer three broad questions about your finance-related experience and qualifications.<\/li>\n<\/ol>\n<p>The entire study takes approximately <b>10\u201315 minutes<\/b>.<\/p>\n<p><b>Data collection:<\/b> No webcam, audio, or video data will be collected. You will not be asked about your own finances, employer, or other sensitive personal matters. Only your scenario ratings and broad finance-background answers will be recorded.<\/p>\n\n<h3>Voluntary Participation and Participant\u2019s Rights<\/h3>\n<p>Your participation is entirely voluntary. You can stop at any time without giving a reason by closing your browser, without penalty. Because the survey is anonymous and no participant-specific survey identifier will be retained, once you submit your response it may not be possible for the research team to identify and delete your individual response.<\/p>\n\n<h3>Risks and Discomforts<\/h3>\n<p>There are no anticipated risks beyond ordinary professional judgement tasks. You may experience mild fatigue from evaluating multiple scenarios.<\/p>\n\n<h3>Benefits<\/h3>\n<p>There are no direct benefits to participants. This validation will help ensure that scenarios used in later research on AI-generated financial advice are independently evaluated before use.<\/p>\n\n<h3>Compensation<\/h3>\n<p>You will receive <b>US$3<\/b> for completing the study. Payment will be made through Prolific (www.prolific.com).<\/p>\n\n<h3>Confidentiality of Data<\/h3>\n<p>The Qualtrics survey will not collect names, email addresses, telephone numbers, employer names, IP addresses, precise location data, or Prolific IDs. Prolific may hold account information needed to administer recruitment and payment, but those platform identifiers will not be linked by the research team to the Qualtrics research responses.<\/p>\n<p>Research data will be kept confidential and stored for a minimum of 10 years in a secure environment within NTU. Access will be restricted to the Principal Investigator, authorised study team members, and School Administrators as required. Individual-level expert-validation responses are not intended to be publicly deposited. The later research paper may state that the scenarios were independently expert-validated and may report aggregate validation results where methodologically necessary. No participant will be identifiable in any report or publication.<\/p>\n\n<h3>Who to contact if you have questions<\/h3>\n<p>For questions, complaints, or feedback about the research, contact the Principal Investigator: Nattavudh (Nick) Powdthavee (<a href=\"mailto:nick.powdthavee@ntu.edu.sg\">nick.powdthavee@ntu.edu.sg<\/a>).<\/p>\n<p>For an independent opinion about your rights as a research participant, contact:<br>\n<b>NTU Institutional Review Board<\/b><br>\nResearch Integrity and Ethics Office<br>\nBlk N1.2, B1-02A, 62 Nanyang Drive, Singapore 637459<br>\nEmail: <a href=\"mailto:irb@ntu.edu.sg\">irb@ntu.edu.sg<\/a>, Tel: 6904 1293<\/p>\n\n<h3>Electronic Consent<\/h3>\n<p>Please indicate below whether you wish to take part. You may print or save this page for your records if you wish.<\/p>","DataExportTag":"CONSENT_INFO","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Study Information Sheet","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"Language":[],"NextChoiceId":1,"NextAnswerId":1}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID91","SecondaryAttribute":"Electronic consent","TertiaryAttribute":null,"Payload":{"QuestionText":"<b>Please select one option:<\/b>","DataExportTag":"CONSENT","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Electronic consent","Choices":{"1":{"Display":"I have read and understood the information above. I certify that I am 21 years old or older and agree to participate in this study."},"2":{"Display":"I do not wish to participate in this study."}},"ChoiceOrder":["1","2"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"Language":[],"NextChoiceId":3,"NextAnswerId":1}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID94","SecondaryAttribute":"\u00a0","TertiaryAttribute":null,"Payload":{"QuestionText":"<img src=\"https:\/\/ntusingapore.qualtrics.com\/CP\/Graphic.php?IM=IM_PBJstQaf0TapkQ9\" style=\"width: 1080px; height: 1358px;\" \/>&nbsp;<img src=\"https:\/\/ntusingapore.qualtrics.com\/CP\/Graphic.php?IM=IM_AnOs5N9J0TLy3Wm\" style=\"width: 1050px; height: 1134px;\" \/>","DefaultChoices":false,"DataExportTag":"Consent form ","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"\u00a0","Choices":{"1":{"Display":"I have read and understood the above consent form. I certify that I am 21 years old or older and, by clicking the next button to enter the survey, I indicate my willingness to voluntarily take part in the study."},"2":{"Display":"I do not wish to participate in this study."}},"ChoiceOrder":[1,2],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":3,"NextAnswerId":1,"QuestionID":"QID94"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID95","SecondaryAttribute":"What is your Prolific ID?","TertiaryAttribute":null,"Payload":{"QuestionText":"What is your Prolific ID?","DefaultChoices":{"TEXT":{"Text":"${e:\/\/Field\/PROLIFIC_ID}"}},"DataExportTag":"Q2","QuestionType":"TE","Selector":"ML","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"What is your Prolific ID?","Validation":{"Settings":{"ForceResponse":"OFF","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"SearchSource":{"AllowFreeResponse":"false"},"QuestionID":"QID95"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID96","SecondaryAttribute":"Thank you for taking part in this study.Please click the button below to be redirected back to Pr...","TertiaryAttribute":null,"Payload":{"QuestionText":"Thank you for taking part in this study.Please click the button below to be redirected back to Prolific and register your submission.","DefaultChoices":false,"DataExportTag":"end_of_survey","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Thank you for taking part in this study.Please click the button below to be redirected back to Pr...","ChoiceOrder":[],"Validation":{"Settings":{"Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":4,"NextAnswerId":1,"QuestionID":"QID96"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID97","SecondaryAttribute":"With this question, we want to ensure\u00a0participants pay attention. Please select the option Thaila..","TertiaryAttribute":null,"Payload":{"QuestionText":"With this question, we want to ensure&nbsp;participants pay attention. Please select the option Thailand from the list below. <b>&nbsp;<\/b>","DefaultChoices":false,"DataExportTag":"attention_check ","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"With this question, we want to ensure\u00a0participants pay attention. Please select the option Thaila...","Choices":{"1":{"Display":"Japan"},"2":{"Display":"Thailand"},"3":{"Display":"South Korea"},"4":{"Display":"Vietnam"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","ForceResponseType":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID97"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"STAT","PrimaryAttribute":"Survey Statistics","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"MobileCompatible":true,"ID":"Survey Statistics"}}]}