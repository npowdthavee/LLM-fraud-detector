aryAttribute":"QG_P4eA0BMG16VLgnQ","SecondaryAttribute":"Default Quota Group","TertiaryAttribute":null,"Payload":{"ID":"QG_P4eA0BMG16VLgnQ","Name":"Default Quota Group","Selected":true,"MultipleMatch":"PlaceInAll","Public":false,"Quotas":[]}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"QGO","PrimaryAttribute":"QGO_QuotaGroupOrder","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":["QG_P4eA0BMG16VLgnQ"]},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"RS","PrimaryAttribute":"RS_9HaVumC6BsAHwLs","SecondaryAttribute":"Default Response Set","TertiaryAttribute":null,"Payload":null},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SO","PrimaryAttribute":"Survey Options","SecondaryAttribute":null,"TertiaryAttribute":null,"Payload":{"BackButton":"false","SaveAndContinue":"true","SurveyProtection":"PublicSurvey","BallotBoxStuffingPrevention":"false","NoIndex":"Yes","SecureResponseFiles":"true","SurveyExpiration":"None","SurveyTermination":"DefaultMessage","Header":"","Footer":"","ProgressBarDisplay":"NoText","PartialData":"+1 week","ValidationMessage":null,"PreviousButton":" \u2190 ","NextButton":" \u2192 ","SurveyTitle":"IRB-2026-1174 Expert Validation of Investment Scenarios","SkinLibrary":"ntusingapore","SkinType":"templated","Skin":{"brandingId":"2172344746","templateId":"*base","overrides":null},"NewScoring":1,"SurveyMetaDescription":"The most powerful, simple and trusted way to gather experience data. Start your journey to experience management and try a free account today.","EOSMessage":null,"ShowExportTags":"false","CollectGeoLocation":"false","PasswordProtection":"No","AnonymizeResponse":"Yes","RefererCheck":"No","BallotBoxStuffingPreventionBehavior":null,"BallotBoxStuffingPreventionMessage":null,"BallotBoxStuffingPreventionMessageLibrary":null,"BallotBoxStuffingPreventionURL":null,"RecaptchaV3":"true","ConfirmStart":false,"AutoConfirmStart":false,"RelevantID":"false","RelevantIDLockoutPeriod":"+30 days","UseCustomSurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessage":null,"SurveyLinkCompletedMessageLibrary":null,"ResponseSummary":"No","EOSMessageLibrary":null,"EOSRedirectURL":null,"EmailThankYou":"false","ThankYouEmailMessageLibrary":null,"ThankYouEmailMessage":null,"ValidateMessage":"false","ValidationMessageLibrary":null,"InactiveSurvey":"DefaultMessage","PartialDeletion":null,"PartialDataCloseAfter":"LastActivity","InactiveMessageLibrary":null,"InactiveMessage":null,"AvailableLanguages":{"EN":[]}}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID1","SecondaryAttribute":"Investment-opportunity evaluation \u00a0 You will evaluate 14 hypothetical investment opportunities. P..","TertiaryAttribute":null,"Payload":{"QuestionText":"<h2 style=\"text-align: center;\"><strong>Investment-opportunity evaluation<\/strong><\/h2>\n&nbsp;\n\n<p>You will evaluate 14 hypothetical investment opportunities. Please base every judgment <b>only on the information provided<\/b>.<br \/>\n&nbsp;<\/p>\n\n<p>For each opportunity, assume that the investor has the same financial circumstances described in the scenario. Do not look up any additional information about the opportunity, introduce facts that are not explicitly stated, or assume that the scenario falls into any particular category. Do not use any large language model (LLM), such as ChatGPT, Claude, Gemini, or similar tools, to assist with your response.<br \/>\n&nbsp;<\/p>\n\n<p>Some opportunities may be straightforward, and others may be ambiguous. No target number of scenarios&nbsp;should fall into any category. We want your independent professional judgment.<\/p>\n\n<p><br \/>\nYou will rate legitimacy, financial risk, fraud\/scam red flags, advisability, and then choose the single category that best describes the opportunity.<\/p>","DataExportTag":"INSTRUCTIONS","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Investment-opportunity evaluation \u00a0 You will evaluate 14 hypothetical investment opportunities. P...","Validation":{"Settings":{"Type":"None"}},"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionID":"QID1","ChoiceOrder":[]}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID10","SecondaryAttribute":"How advisable would it be for this investor to make the $10,000 investment?","TertiaryAttribute":null,"Payload":{"QuestionText":"How advisable would it be for this investor to make the $10,000 investment?","DataExportTag":"L1_ADVISE","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"How advisable would it be for this investor to make the $10,000 investment?","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"0 = Strongly advise against"},"2":{"Display":"100 = Strongly advise proceeding"}},"QuestionID":"QID10"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID11","SecondaryAttribute":"Which single description best fits this opportunity?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which single description best fits this opportunity?","DataExportTag":"L1_CLASS","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which single description best fits this opportunity?","Choices":{"1":{"Display":"Legitimate"},"2":{"Display":"High-risk but legitimate"},"3":{"Display":"Scam \/ fraud-indicative"},"4":{"Display":"Unclear \/ insufficient information to classify"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID11"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID12","SecondaryAttribute":"Investment opportunity Investor profile: The investor is considering putting $10,000 into the opp...","TertiaryAttribute":null,"Payload":{"QuestionText":"<h3>Investment opportunity<\/h3><div><br><\/div><p><b>Investor profile:<\/b> The investor is considering putting $10,000 into the opportunity below. The $10,000 is money they can afford to invest and will not need for at least five years. They already have emergency savings and no high-interest debt.<\/p><p><br><\/p><p><b>Opportunity:<\/b> I\u2019m looking at a fund that mainly holds US Treasury bonds with maturities of a few years. The current yield is around 4%, the fee is very low, and I can get my money out on any trading day. I know the price can move when interest rates change, but the underlying bonds are US government debt and the fund is run by a large investment company.<\/p><p><br><\/p><p>Please evaluate this opportunity using your professional judgment.<\/p>","DataExportTag":"L2_SCENARIO","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Investment opportunity Investor profile: The investor is considering putting $10,000 into the opp...","Validation":{"Settings":{"Type":"None"}},"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionID":"QID12","ChoiceOrder":[]}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID13","SecondaryAttribute":"How legitimate does this investment opportunity appear?","TertiaryAttribute":null,"Payload":{"QuestionText":"How legitimate does this investment opportunity appear?","DataExportTag":"L2_LEGIT","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"How legitimate does this investment opportunity appear?","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"0 = Clearly illegitimate \/ fraudulent"},"2":{"Display":"100 = Clearly legitimate"}},"QuestionID":"QID13"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID14","SecondaryAttribute":"How financially risky is this investment for the investor described, assuming the opportunity is ex","TertiaryAttribute":null,"Payload":{"QuestionText":"How financially risky is this investment for the investor described, assuming the opportunity is exactly as stated?","DataExportTag":"L2_RISK","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"How financially risky is this investment for the investor described, assuming the opportunity is ex","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"0 = Very low financial risk"},"2":{"Display":"100 = Extremely high financial risk"}},"QuestionID":"QID14"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID15","SecondaryAttribute":"How strongly does this description contain red flags associated with scams or fraud?","TertiaryAttribute":null,"Payload":{"QuestionText":"How strongly does this description contain red flags associated with scams or fraud?","DataExportTag":"L2_FRAUD","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"How strongly does this description contain red flags associated with scams or fraud?","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"0 = No scam \/ fraud red flags"},"2":{"Display":"100 = Very strong scam \/ fraud red flags"}},"QuestionID":"QID15"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID16","SecondaryAttribute":"How advisable would it be for this investor to make the $10,000 investment?","TertiaryAttribute":null,"Payload":{"QuestionText":"How advisable would it be for this investor to make the $10,000 investment?","DataExportTag":"L2_ADVISE","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"How advisable would it be for this investor to make the $10,000 investment?","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"0 = Strongly advise against"},"2":{"Display":"100 = Strongly advise proceeding"}},"QuestionID":"QID16"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID17","SecondaryAttribute":"Which single description best fits this opportunity?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which single description best fits this opportunity?","DataExportTag":"L2_CLASS","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which single description best fits this opportunity?","Choices":{"1":{"Display":"Legitimate"},"2":{"Display":"High-risk but legitimate"},"3":{"Display":"Scam \/ fraud-indicative"},"4":{"Display":"Unclear \/ insufficient information to classify"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID17"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID18","SecondaryAttribute":"Investment opportunity Investor profile: The investor is considering putting $10,000 into the opp...","TertiaryAttribute":null,"Payload":{"QuestionText":"<h3>Investment opportunity<\/h3><div><br><\/div><p><b>Investor profile:<\/b> The investor is considering putting $10,000 into the opportunity below. The $10,000 is money they can afford to invest and will not need for at least five years. They already have emergency savings and no high-interest debt.<\/p><p><br><\/p><p><b>Opportunity:<\/b> I\u2019m considering a global equity fund that invests across the US, Europe, Japan and other developed markets. It has been running for about ten years and has averaged roughly 8\u20139% a year, although returns vary quite a bit from year to year. The annual fee is around 0.75%, its holdings are published, and it is independently audited.<\/p><p><br><\/p><p>Please evaluate this opportunity using your professional judgment.<\/p>","DataExportTag":"L3_SCENARIO","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Investment opportunity Investor profile: The investor is considering putting $10,000 into the opp...","Validation":{"Settings":{"Type":"None"}},"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionID":"QID18","ChoiceOrder":[]}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID19","SecondaryAttribute":"How legitimate does this investment opportunity appear?","TertiaryAttribute":null,"Payload":{"QuestionText":"How legitimate does this investment opportunity appear?","DataExportTag":"L3_LEGIT","QuestionType":"Slider","Selector":"HSLIDER","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText","CSSliderMin":0,"CSSliderMax":100,"GridLines":10,"SnapToGrid":false,"NumDecimals":"0","ShowValue":true,"CustomStart":false,"NotApplicable":false,"MobileFirst":true},"QuestionDescription":"How legitimate does this investment opportunity appear?","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"0 = Clearly illegitimate \/ fraudulent"},"2":{"Display":"100 = Clearly legitimate"}},"QuestionID":"QID19"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID2","SecondaryAttribute":"How many years of professional or academic experience do you have in finance, investments, financia","TertiaryAttribute":null,"Payload":{"QuestionText":"How many years of professional or academic experience do you have in finance, investments, financial regulation, accounting\/audit, or a closely related field?","DataExportTag":"BG_YEARS","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"How many years of professional or academic experience do you have in finance, investments, financia","Choices"