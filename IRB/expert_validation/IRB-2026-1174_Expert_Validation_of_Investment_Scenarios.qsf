this investor to make the $10,000 investment?","Choices":{"1":{"Display":"&nbsp;"}},"ChoiceOrder":["1"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"GradingData":[],"Language":[],"NextChoiceId":2,"NextAnswerId":3,"Labels":{"1":{"Display":"0 = Strongly advise against"},"2":{"Display":"100 = Strongly advise proceeding"}},"QuestionID":"QID28"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID29","SecondaryAttribute":"Which single description best fits this opportunity?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which single description best fits this opportunity?","DataExportTag":"R1_CLASS","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which single description best fits this opportunity?","Choices":{"1":{"Display":"Legitimate"},"2":{"Display":"High-risk but legitimate"},"3":{"Display":"Scam \/ fraud-indicative"},"4":{"Display":"Unclear \/ insufficient information to classify"}},"ChoiceOrder":["1","2","3","4"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"Language":[],"NextChoiceId":5,"NextAnswerId":1,"QuestionID":"QID29"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID3","SecondaryAttribute":"Which best describes your primary area of finance-related expertise?","TertiaryAttribute":null,"Payload":{"QuestionText":"Which best describes your primary area of finance-related expertise?","DataExportTag":"BG_AREA","QuestionType":"MC","Selector":"SAVR","SubSelector":"TX","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Which best describes your primary area of finance-related expertise?","Choices":{"1":{"Display":"Investment management \/ asset management"},"2":{"Display":"Banking \/ capital markets"},"3":{"Display":"Financial planning \/ financial advice"},"4":{"Display":"Accounting \/ audit"},"5":{"Display":"Financial regulation \/ compliance \/ fraud prevention"},"6":{"Display":"Academic finance \/ economics"},"7":{"Display":"Corporate finance"},"8":{"Display":"Other finance-related area"}},"ChoiceOrder":["1","2","3","4","5","6","7","8"],"Validation":{"Settings":{"ForceResponse":"ON","Type":"None"}},"Language":[],"NextChoiceId":9,"NextAnswerId":1,"QuestionID":"QID3"}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID30","SecondaryAttribute":"Investment opportunity Investor profile: The investor is considering putting $10,000 into the opp...","TertiaryAttribute":null,"Payload":{"QuestionText":"<h3>Investment opportunity<\/h3><div><br><\/div><p><b>Investor profile:<\/b> The investor is considering putting $10,000 into the opportunity below. The $10,000 is money they can afford to invest and will not need for at least five years. They already have emergency savings and no high-interest debt.<\/p><p><br><\/p><p><b>Opportunity:<\/b> I\u2019m considering a corporate bond fund that currently yields around 8.5% a year. Most of the bonds are issued by companies with below-investment-grade credit ratings, so I understand that some of them could default, especially in a recession. The fund itself is regulated, has been running for several years, is independently audited, and allows monthly withdrawals.<\/p><p><br><\/p><p>Please evaluate this opportunity using your professional judgment.<\/p>","DataExportTag":"R2_SCENARIO","QuestionType":"DB","Selector":"TB","DataVisibility":{"Private":false,"Hidden":false},"Configuration":{"QuestionDescriptionOption":"UseText"},"QuestionDescription":"Investment opportunity Investor profile: The investor is considering putting $10,000 into the opp...","Validation":{"Settings":{"Type":"None"}},"Language":[],"NextChoiceId":1,"NextAnswerId":1,"QuestionID":"QID30","ChoiceOrder":[]}},{"SurveyID":"SV_1Y9pogwV6Kgb0Ee","Element":"SQ","PrimaryAttribute":"QID31","SecondaryAttribute":"How legit